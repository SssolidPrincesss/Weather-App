<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Фоновая полоса (светло-голубой) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3E5FC" /> <!-- светло-голубой фон -->
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Заполненная часть (насыщенный голубой) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#29B6F6" /> <!-- ярко-голубой заполнитель -->
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>