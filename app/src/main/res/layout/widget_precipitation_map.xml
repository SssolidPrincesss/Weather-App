<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_card_translucent"
    android:padding="16dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp">

    <!-- Заголовок -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Карта осадков"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <!-- Карта осадков -->
    <FrameLayout
        android:id="@+id/flPrecipitationContainer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@android:color/darker_gray"
        android:layout_marginBottom="8dp">

        <!-- Изображение карты -->
        <ImageView
            android:id="@+id/ivPrecipitationMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="Карта осадков" />

        <!-- Круглый индикатор загрузки -->
        <ProgressBar
            android:id="@+id/pbPrecipitationLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Текст ошибки -->
        <TextView
            android:id="@+id/tvPrecipitationError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Ошибка загрузки карты осадков"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>



</LinearLayout>