<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 🌤 Фон -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:scaleType="centerCrop"
         />

    <!-- 📍 Локация — фиксированная -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags=""
            app:contentScrim="#40000000">

            <!-- Блок локации -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:padding="8dp"
                app:layout_collapseMode="pin">

                <!-- Иконка местоположения -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_location"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/location_icon" />

                <!-- Название региона -->
                <TextView
                    android:id="@+id/tvLocationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Верхняя Пышма"
                    android:textSize="18sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 📜 Основной контент с возможностью скролла -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ⚠️ ЕДИНСТВЕННЫЙ дочерний элемент NestedScrollView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Температура и описание -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="0dp"/>

                <TextView
                    android:id="@+id/tvWeatherDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="64dp"/>

            </LinearLayout>

            <!-- Ощущается как -->
            <TextView
                android:id="@+id/tvFeelsLike"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <!-- Прогноз на 7 дней -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_card_translucent"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Вчера -->
                <LinearLayout
                    android:id="@+id/llDay1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="4dp">
                    <TextView
                        android:id="@+id/tvDay1"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="ВС"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_gravity="center_vertical" />
                    <ImageView
                        android:id="@+id/ivWeather1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_sunny_day"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvTemp1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="−15° / −7°"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <!-- Сегодня -->
                <LinearLayout
                    android:id="@+id/llDay2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="4dp">
                    <TextView
                        android:id="@+id/tvDay2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Сегодня"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_gravity="center_vertical" />
                    <ImageView
                        android:id="@+id/ivWeather2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_sunny_day"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvTemp2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="−12° / −4°"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <!-- Завтра -->
                <LinearLayout
                    android:id="@+id/llDay3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="4dp">
                    <TextView
                        android:id="@+id/tvDay3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Завтра"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_gravity="center_vertical" />
                    <ImageView
                        android:id="@+id/ivWeather3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_cloudy_day"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvTemp3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="−9° / −2°"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <!-- День 4 -->
                <LinearLayout
                    android:id="@+id/llDay4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="4dp">
                    <TextView
                        android:id="@+id/tvDay4"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="ПН"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_gravity="center_vertical" />
                    <ImageView
                        android:id="@+id/ivWeather4"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_sunny_day"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvTemp4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="−6° / 0°"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <!-- День 5 -->
                <LinearLayout
                    android:id="@+id/llDay5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="4dp">
                    <TextView
                        android:id="@+id/tvDay5"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="ВТ"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_gravity="center_vertical" />
                    <ImageView
                        android:id="@+id/ivWeather5"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_cloudy_day"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvTemp5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="−4° / 2°"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <!-- День 6 -->
                <LinearLayout
                    android:id="@+id/llDay6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="4dp">
                    <TextView
                        android:id="@+id/tvDay6"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="СР"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_gravity="center_vertical" />
                    <ImageView
                        android:id="@+id/ivWeather6"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_sunny_day"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvTemp6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="−2° / 4°"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <!-- День 7 -->
                <LinearLayout
                    android:id="@+id/llDay7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="4dp">
                    <TextView
                        android:id="@+id/tvDay7"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="ЧТ"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_gravity="center_vertical" />
                    <ImageView
                        android:id="@+id/ivWeather7"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_cloudy_day"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvTemp7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0° / 6°"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- 🌅 Плашка восход/закат -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card_translucent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- График с градиентом -->
                <com.example.weatherapp.ui.main.SunriseGraphView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp" />

                <!-- Восход и Закат -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:weightSum="2">

                    <!-- Восход -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Восход"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvSunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09:34"
                            android:textSize="24sp"
                            android:textColor="@android:color/white"
                            android:fontFamily="sans-serif-black" />

                    </LinearLayout>

                    <!-- Закат -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Закат"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvSunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="16:17"
                            android:textSize="24sp"
                            android:textColor="@android:color/white"
                            android:fontFamily="sans-serif-black" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- 🌬 + 💨 Влажность и Ветер -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <!-- 🌬 Влажность -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="230dp"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_translucent"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Влажность"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <!-- Обёртка для прогресса -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center">

                        <!-- Вертикальный прогресс-бар — теперь КРУПНЕЕ -->
                        <ProgressBar
                            android:id="@+id/pbHumidity"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:rotation="270"
                            android:progress="10"
                            android:max="100"
                            android:indeterminate="false"
                            android:progressDrawable="@drawable/progress_vertical"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/tvHumidityValue"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Значение внизу -->
                        <TextView
                            android:id="@+id/tvHumidityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10%"
                            android:textSize="20sp"
                            android:textColor="@android:color/white"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginBottom="8dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <!-- 💨 Ветер -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="230dp"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_translucent"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ветер"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="2dp" />

                    <!-- Направление ветра (над компасом) -->
                    <TextView
                        android:id="@+id/tvWindDirectionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="СВ"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="4dp" />

                    <!-- Обёртка для компаса -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center">

                        <!-- Круговой компас -->
                        <ImageView
                            android:id="@+id/ivCompassRing"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:src="@drawable/compass_ring"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Направления компаса -->
                        <ImageView
                            android:id="@+id/ivCompassDirections"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:src="@drawable/compass_directions"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Стрелка ветра -->
                        <ImageView
                            android:id="@+id/ivWindDirection"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/ic_wind_arrow"
                            android:rotation="0"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Блок скорости и описания -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="2dp">

                        <!-- Скорость ветра -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvWindSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:textColor="@android:color/white"
                                android:fontFamily="sans-serif-black"
                                android:text="10" />

                            <TextView
                                android:id="@+id/tvWindUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@android:color/white"
                                android:fontFamily="sans-serif-medium"
                                android:text="км/ч"
                                android:layout_marginStart="2dp" />
                        </LinearLayout>

                        <!-- Описание силы ветра -->
                        <TextView
                            android:id="@+id/tvWindDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Умеренный ветер"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- 🕒 Прогноз на 24 часа -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card_translucent"
                android:padding="16dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="16dp">

                <!-- Заголовок -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHourlyForecast"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingEnd="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Прогноз на 24 часа"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <!-- Список часов -->

            </LinearLayout>

            <include
                layout="@layout/widget_precipitation_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"/>

        </LinearLayout> <!-- ⬅️ ЕДИНСТВЕННЫЙ дочерний элемент NestedScrollView -->

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>